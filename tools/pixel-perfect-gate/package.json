{
  "name": "@eval-tools/pixel-perfect-gate",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic visual & layout gate for AI coding agents (Gate 1 layout/runtime + Gate 2 pixelmatch/wireframe + Gate 3 skill).",
  "bin": {
    "pixel-gate": "./bin/pixel-gate.mjs"
  },
  "scripts": {
    "test": "node --test tests/pixel-gate.test.mjs && node --test --test-concurrency=1 tests/acceptance/m1-landmarks.acceptance.test.mjs tests/acceptance/m1-engine.acceptance.test.mjs tests/acceptance/m1-report.acceptance.test.mjs tests/acceptance/m2/m2-shipped-break-its.test.mjs tests/acceptance/m2b/m2b-shipped-break-its.test.mjs tests/acceptance/m3/m3-depends.test.mjs && node ../../scripts/acceptance-status.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "playwright": "1.65.1"
  }
}
